#!/usr/bin/env python
"""
Lexa compiler script.

This script compiles Lexa programs. Depending on the LEXA_MODE environment variable, 
it will use either the dune exec or the binary directly.
- LEXA_MODE=dev (default): Uses 'dune exec lexac' for development
- LEXA_MODE=user: Uses the 'lexac' binary directly for users
"""
import argparse
import subprocess
import os
import sys

def run_commands(source_file, output_file, lexac_args, output_ll, tl, stack_size, gstack, verbose):
    # Set up output redirection based on verbose flag
    if verbose:
        stdout_redirect = None
        stderr_redirect = None
    else:
        stdout_redirect = subprocess.DEVNULL
        stderr_redirect = subprocess.DEVNULL
    
    src_path = os.path.abspath(source_file)

    if source_file.endswith(".c"):
        c_file = src_path
    else:
        base_name = os.path.basename(src_path)
        c_file = os.path.dirname(src_path) + "/" + os.path.splitext(base_name)[0] + ".c"

        # Check if we're in user mode (using binary) or dev mode (using dune exec)
        lexa_mode = os.environ.get("LEXA_MODE", "dev")
        
        if lexa_mode == "user":
            # Use the binary directly
            lexac_command = ["lexac", src_path, "-o", c_file]
        else:
            # Use dune exec (dev mode)
            subprocess.run(["dune", "clean"], check=True)
            lexac_command = ["dune", "exec", "lexac", "--", src_path, "-o", c_file]
        
        if tl:
            lexac_command.append("--tl")
        if lexac_args:
            lexac_command += lexac_args.split()
        
        subprocess.run(lexac_command, check=True, stdout=stdout_redirect, stderr=stderr_redirect)

    passes = [
        "addNoCapture/AddNoCaptureToAsmPass.so", 
        "attachMetadata/AttachMetadataPass.so",
        "markInvariant/MarkInvariantPass.so",
        "generateStackMap/GenerateStackMapPass.so"
        ]
    
    include_paths = ["-I", os.path.dirname(os.path.realpath(__file__)) + "/src/stacktrek", "-I", os.path.dirname(src_path), "-I", os.path.dirname(os.path.realpath(__file__)) + "/src/stackwalk"]

    if output_ll:
        clang_ll_command = ["clang", "-S", "-emit-llvm", "-O3", c_file, "-o", source_file.split(".")[0] + ".ll", "-DNO_OFFSET"] + include_paths
        for path in passes:
            clang_ll_command += ["-Xclang", "-fpass-plugin=" + os.path.dirname(os.path.realpath(__file__)) + "/passes/" + path]
        
        subprocess.run(clang_ll_command, check=True, stdout=stdout_redirect, stderr=stderr_redirect)

    compilation_unit = [c_file, os.path.dirname(os.path.realpath(__file__)) + "/src/stackwalk/stackwalk.c"]
    clang_command = ["clang", "-g", "-O3", "-o", output_file, "-lm", "-lgc", "-Wl,--section-start=.init=0x2000"] + compilation_unit + include_paths # -Wl,--section-start=.init=0x2000 is to make sure the code has a fixed address. This is not necessary when offset_functions.h is created automatically.
    for path in passes:
        clang_command += ["-Xclang", "-fpass-plugin=" + os.path.dirname(os.path.realpath(__file__)) + "/passes/" + path]
    
    if stack_size:
        clang_command += ["-DSTACK_SIZE=" + str(stack_size * 1024)]

    if gstack:
        clang_command += ["-lmprompt", "-DUSE_GSTACK"]

    # link-time optimization may seem like a good idea
    # but we disable it because we need to keep the function address stable
    # while changing the definition of stackwalk function
    lto = False
    if lto:
        clang_command += ["-fuse-ld=lld", "-flto"]

    # We compile twice. The first time we produce the binary for analysis.
    subprocess.run(clang_command + ["-DNO_OFFSET"], check=True, stdout=stdout_redirect, stderr=stderr_redirect)
    
    analyze_command = [os.path.dirname(os.path.realpath(__file__)) + "/src/stackwalk/analyze_binary.py", output_file, "--gen-offset", "--path", os.path.dirname(src_path)]
    subprocess.run(analyze_command, check=True, stdout=stdout_redirect, stderr=stderr_redirect)

    # The second time we produce the binary for execution
    subprocess.run(clang_command, check=True, stdout=stdout_redirect, stderr=stderr_redirect)
    
    analyze_command = [os.path.dirname(os.path.realpath(__file__)) + "/src/stackwalk/analyze_binary.py", output_file]
    subprocess.run(analyze_command, check=True, stdout=stdout_redirect, stderr=stderr_redirect)


def main():
    parser = argparse.ArgumentParser(description="Compile lexa programs.")
    parser.add_argument("source_file", type=str, help="The source file to compile")
    parser.add_argument("--output-ll", action="store_true", help="Output the generated LLVM IR")
    parser.add_argument("-o", "--output", type=str, default="a.out", help="The binary output file")
    parser.add_argument("--stack-size", type=int, help="The size of each stack (in KB)")
    parser.add_argument("--lexac-args", type=str, default="", help="Arguments to pass to lexac")
    parser.add_argument("--tl", action="store_true", help="Compile with TL syntax")
    parser.add_argument("--gstack", action="store_true", default=True, help="Use growable stacks")
    parser.add_argument("--verbose", action="store_true", help="Show verbose output including compiler warnings")
    
    args = parser.parse_args()

    try:
        run_commands(args.source_file, args.output, args.lexac_args, args.output_ll, args.tl, args.stack_size, args.gstack, args.verbose)
    except subprocess.CalledProcessError as e:
        if not args.verbose:
            print(f"Error during compilation. Use --verbose to see detailed error messages.")
        sys.exit(1)

if __name__ == "__main__":
    main()
